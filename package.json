{
  "name": "netguard",
  "version": "2.0.0",
  "private": true,
  "description": "NetGuard: DNS-level gambling-site filtering for households and organisations.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "node scripts/build-assets.js && node scripts/build-map.js",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "NODE_ENV=development node --disable-warning=ExperimentalWarning --watch server/index.js",
    "bench": "node --disable-warning=ExperimentalWarning scripts/bench.js",
    "test": "node scripts/check-contrast.js && node --disable-warning=ExperimentalWarning --test \"tests/*.test.js\"",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/ibm-plex-sans": "^5.2.6",
    "fontkit": "^2.0.4",
    "sharp": "^0.35.3",
    "wawoff2": "^2.0.1"
  }
}
