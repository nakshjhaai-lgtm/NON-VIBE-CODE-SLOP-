# Copy to .env and fill in. Nothing here has a default that is safe for a
# public deployment; the two keys in particular MUST be set, or they are
# regenerated on every restart and every session and form token is invalidated.

# Public origin, used for canonical URLs, the sitemap and social card tags.
NETGUARD_ORIGIN=https://netguard.example

# 32+ random bytes, hex. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
NETGUARD_CSRF_KEY=
NETGUARD_ANALYTICS_SALT=

# Set to 1 only when the app sits behind a reverse proxy you control. It makes
# the app trust X-Forwarded-For and X-Forwarded-Proto; trusting those on a
# directly exposed server lets a client spoof its own address.
NETGUARD_TRUST_PROXY=0

# Where the SQLite file lives. Must be on persistent storage.
NETGUARD_DB=./data/netguard.db

# Enables HSTS and the HTTPS redirect, and disables verbose error output.
NODE_ENV=production

PORT=3000
HOST=0.0.0.0
