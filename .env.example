# Optional NetGuard settings for Netlify Edge Functions.
#
# A production deploy needs no application secret or database configuration:
# Netlify injects Blob credentials, the CSRF value is generated per browser,
# and the analytics salt is persisted in Blob state.
#
# For Netlify, set values in Project configuration > Environment variables with
# Functions scope. This file is only a template for optional local tooling.

# Canonical public origin. If omitted, Netlify's built-in URL is used, followed
# by the reserved demonstration origin https://netguard.example.
NETGUARD_ORIGIN=https://netguard.example

# Optional cache-busting value for checked-in CSS and JavaScript.
# NETGUARD_ASSET_VERSION=2026-08-28-2

# Optional framing policy for non-production previews, useful for an authorised
# embedded preview. Production always uses frame-ancestors 'none'.
# NETGUARD_FRAME_ANCESTORS='self' https://preview-host.example
